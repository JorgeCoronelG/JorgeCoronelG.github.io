---
interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  id: string;
}
const { eyebrow, title, subtitle, id } = Astro.props;
---

<div class="reveal">
  <p class="flex items-center gap-4 text-[22px] font-bold tracking-wide text-accent">
    <span class="h-[3px] w-9 bg-accent" aria-hidden="true"></span>{eyebrow}
  </p>
  <h2 id={id} class="mt-3 font-serif text-4xl leading-tight sm:text-5xl lg:text-h2">{title}</h2>
  <p class="mt-3 text-lg text-muted sm:text-[22px]">{subtitle}</p>
</div>
