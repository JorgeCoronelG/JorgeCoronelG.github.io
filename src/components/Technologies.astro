---
import { technologies } from '../data/technologies';
import SectionHeading from './SectionHeading.astro';
---

<section id="tecnologias" data-nav="experiencia" aria-labelledby="tecnologias-titulo" class="container-page py-16 lg:py-24">
  <div class="flex flex-col justify-between gap-4 lg:flex-row lg:items-end">
    <SectionHeading id="tecnologias-titulo" eyebrow="Tecnologías" title="Con lo que trabajo" subtitle="Las tecnologías con las que he construido y mantenido sistemas web." />
    <p class="flex items-center gap-2 text-sm text-muted">
      <span class="chip-accent h-5 w-10" aria-hidden="true"></span>Stack principal
    </p>
  </div>
  <div class="mt-10 border-y border-line">
    {
      technologies.map((cat) => (
        <div class="reveal grid gap-4 border-b border-line py-6 last:border-b-0 md:grid-cols-[330px_1fr] md:items-center">
          <div>
            <h3 class="font-serif text-2xl">{cat.name}</h3>
            <p class="text-[15px] text-muted">{cat.description}</p>
          </div>
          <ul class="flex flex-wrap gap-2.5">
            {
              cat.items.map((t) => (
                <li class:list={['inline-flex h-[38px] items-center rounded-full px-4 text-lg', t.main ? 'chip-accent' : 'bg-chip text-muted']}>
                  {t.name}
                </li>
              ))
            }
          </ul>
        </div>
      ))
    }
  </div>
</section>
