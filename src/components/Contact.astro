---
import { site } from '../data/site';

const rows = [
  { label: 'Correo', value: site.email, href: `mailto:${site.email}` },
  { label: 'LinkedIn', value: 'linkedin.com/in/jcoronelgonzalez', href: site.linkedin },
  { label: 'GitHub', value: 'github.com/JorgeCoronelG', href: site.github },
];
---

<section id="contacto" data-nav="contacto" aria-labelledby="contacto-titulo" class="container-page grid gap-12 py-16 lg:grid-cols-2 lg:py-24">
  <div class="reveal">
    <p class="flex items-center gap-4 text-[22px] font-bold tracking-wide text-accent">
      <span class="h-[3px] w-9 bg-accent" aria-hidden="true"></span>Contacto
    </p>
    <h2 id="contacto-titulo" class="mt-3 font-serif text-4xl leading-tight sm:text-5xl lg:text-h2">Trabajemos juntos</h2>
    <p class="mt-4 max-w-md text-lg text-muted">
      ¿Tienes un proyecto en mente o necesitas apoyo con un desarrollo de software? Escríbeme y platicamos.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={`mailto:${site.email}`} class="btn rounded-[14px] bg-accent text-bg hover:bg-ink">Escríbeme</a>
      <a href={site.cv} download class="btn rounded-[14px] border-2 border-ink text-ink hover:bg-ink hover:text-bg">Descargar CV</a>
    </div>
  </div>
  <ul class="reveal self-center border-t border-line">
    {
      rows.map((r) => (
        <li class="border-b border-line">
          <a href={r.href} class="group flex items-center justify-between gap-4 py-5" target={r.href.startsWith('mailto') ? undefined : '_blank'} rel="noopener noreferrer">
            <span class="min-w-0">
              <span class="block text-sm text-muted">{r.label}</span>
              <span class="block break-words text-lg font-bold sm:text-[21px]">{r.value}</span>
            </span>
            <span class="text-2xl text-accent transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" aria-hidden="true">↗</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
