---
import { site } from '../data/site';
import Logo from './Logo.astro';
---

<footer class="border-t border-line">
  <div class="container-page flex flex-col items-start justify-between gap-3 py-8 sm:flex-row sm:items-center">
    <Logo class="!text-[28px]" />
    <p class="flex flex-col gap-1 text-base text-muted sm:flex-row sm:gap-8">
      <span>{site.location}</span>
      <span>© {new Date().getFullYear()} {site.name}</span>
    </p>
  </div>
</footer>
