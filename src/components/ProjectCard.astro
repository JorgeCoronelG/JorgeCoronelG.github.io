---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
import ImagePlaceholder from './ImagePlaceholder.astro';

const { project } = Astro.props as { project: Project };
---

<article class="reveal flex flex-col overflow-hidden rounded-[20px] border-2 border-line bg-card shadow-card transition duration-300 hover:-translate-y-1 hover:shadow-card-hover">
  {
    project.image ? (
      <Image src={project.image} alt={project.imageAlt ?? `Captura de ${project.title}`} class="h-[230px] w-full border-b border-line object-cover object-top" />
    ) : (
      <ImagePlaceholder label="Captura del proyecto" window class="h-[230px] border-b border-line" />
    )
  }
  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-center gap-3">
      <h3 class="font-serif text-[25px] leading-tight">{project.title}</h3>
      {project.badge && <span class="chip-accent px-2.5 py-0.5 text-xs">{project.badge}</span>}
    </div>
    <p class="mt-3 text-base text-muted">{project.description}</p>
    <ul class="mt-4 flex flex-wrap gap-2" aria-label="Tecnologías">
      {project.tags.map((t) => <li class="chip">{t}</li>)}
    </ul>
    <div class="mt-auto flex gap-5 pt-5">
      {
        project.links.map((l) => (
          <a href={l.href} class="link-ext" target={l.href === '#' ? undefined : '_blank'} rel="noopener noreferrer">
            {l.label} <span aria-hidden="true">↗</span>
          </a>
        ))
      }
    </div>
  </div>
</article>
