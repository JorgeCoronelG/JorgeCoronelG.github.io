---
import '../styles/global.css';
import { site } from '../data/site';

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{site.title}</title>
		<meta name="description" content={site.description} />
		<meta name="theme-color" content="#F7F7F5" />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_MX" />
		<meta property="og:title" content={site.title} />
		<meta property="og:description" content={site.description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content="https://jorgecoronelg.github.io/og-image-portafolio.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Jorge Coronel, Desarrollador Fullstack" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content="https://jorgecoronelg.github.io/og-image-portafolio.png" />
		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<a
			href="#contenido"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-bg"
			>Saltar al contenido</a
		>
		<slot />
		<script>
			import '../scripts/interactions';
		</script>
	</body>
</html>
